{
    "name": "linker-script",
    "displayName": "Linker Script",
    "description": "The extension is developed for linker script, which mainly provides intelligent complement, grammatical cues, and other functions.",
    "icon": "img/Script.png",
    "publisher": "amapleaf",
    "repository": {
        "url": "https://github.com/amapleaf/linker-script"
    },
    "version": "0.1.0",
    "license": "Apache-2.0",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:ld"
    ],
    "contributes": {
        "languages": [
            {
                "id": "linker-script",
                "aliases": [
                    "Linker Script",
                    "linker-script",
                    "lds"
                ],
                "extensions": [
                    ".lds",
                    ".ld"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "linker-script",
                "scopeName": "source.linker-script",
                "path": "./syntaxes/linker-script.tmLanguage.json"
            }
        ]
    },
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "typecheck": "tsc --noEmit",
        "bundle": "node esbuild.js",
        "compile": "npm run typecheck && npm run bundle",
        "watch": "npm run typecheck && node esbuild.js --watch",
        "lint": "eslint src",
        "test": "npm run compile && npm run test:unit && npm run test:grammar && npm run test:extension",
        "test:unit": "mocha --ui tdd \"dist/test/unit/**/*.test.js\"",
        "test:grammar": "vscode-tmgrammar-test \"test/grammar/**/*.ld\" && node scripts/check-grammar-fixtures.mjs",
        "test:extension": "vscode-test",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^16.18.126",
        "@types/vscode": "~1.74.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.1.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "mocha": "^12.0.3",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.1",
        "vscode-tmgrammar-test": "^0.1.3"
    }
}

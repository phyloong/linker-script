{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es6",
        "lib": [
            "es6"
        ],
        "rootDir": "src",
        "strict": true,
        "noUnusedLocals": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "mocha"
        ]
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "out",
        ".vscode-test"
    ]
}

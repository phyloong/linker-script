{
    "comments": {
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "/*", "close": "*/", "notIn": ["string", "comment"] }
    ],
    "folding": {
        "markers": {
            "start": "^\\s*/\\*\\s*#region\\b",
            "end": "^\\s*/\\*\\s*#endregion\\b"
        }
    },
    "wordPattern": "(\\.?[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*)"
}
